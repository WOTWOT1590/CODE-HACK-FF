<?xml version="1.0" encoding="UTF-8"?>
<projects>
  <!-- Version 1: Hệ thống Anti-Ban & Quyền can thiệp bộ nhớ -->
  <project version="1">
    <component name="SystemAntiBanProtection" JavaVersion="1" />
    <component name="WriteSettingHideVersion" JavaVersion="1">
      <Asset_DataAsset>
        <option name="externalDataAsset" strings="$WRITE_EXTERNALS$" />
        <option name="com.android.accesspointernetwork" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.ACCESS_POINTER_SPEED" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.security.ANTIBAN_BYPASS" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="COMPRESS" strings="true" />
      </Asset_DataAsset>
    </component>
  </project>

  <!-- Version 2: Triệt tiêu 100% độ rung tâm & Ổn định đường đạn -->
  <project version="2">
    <Asset_DataAsset>
      <option name="on=1" strings="$WRITE_FILE$" />
      <option name="off=0" strings="$WRITE_FILE$" />
      
      <!-- Cấu hình triệt tiêu rung lắc (Zero Recoil System) -->
      <option name="Com.Ss-Ffx64.Aps=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.ZeroRecoil=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.NoShake=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.CrosshairLockCenter=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.CameraStability=100" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Giữ độ nhạy và cố định vị trí tâm -->
      <option name="Com.Ss-Ffx64.FrictionControl=0" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.SpreadControl=0" strings="$WRITE_REGULATOR_DATA$" />

      <!-- Tác giả -->
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>

  <!-- Version 3: Kích hoạt launcher & Bypass quét hệ thống -->
  <project version="3">
    <Asset_DataAsset>
      <option name="acp_click=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="on_com.dts.freefireth_launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.restore-device.launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Lớp bảo vệ Anti-Ban chủ động -->
      <option name="com.antiban.shield.active=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.bypass.gameguard.report=1" strings="$WRITE_REGULATOR_DATA$" />

      <!-- Tác giả -->
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>
</projects>