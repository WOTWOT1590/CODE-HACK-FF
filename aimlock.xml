<?xml version="1.0" encoding="UTF-8"?>
<projects>
  <!-- Version 1: Hệ thống Anti-Ban & Quyền truy cập thiết bị -->
  <project version="1">
    <component name="SecurityCore" JavaVersion="1" />
    <component name="WriteSettingHideVersion" JavaVersion="1">
      <Asset_DataAsset>
        <option name="externalDataAsset" strings="$WRITE_EXTERNALS$" />
        <option name="com.android.accesspointernetwork" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.ACCESS_POINTER_SPEED" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <!-- Quyền bảo mật Anti-Ban nâng cao -->
        <option name="com.android.security.ANTIBAN_PROTECTION" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="COMPRESS" strings="true" />
      </Asset_DataAsset>
    </component>
  </project>

  <!-- Version 2: Thuật toán Aimlock đuổi theo mục tiêu di chuyển & Lock Head -->
  <project version="2">
    <Asset_DataAsset>
      <option name="on=1" strings="$WRITE_FILE$" />
      <option name="off=0" strings="$WRITE_FILE$" />
      
      <!-- Cấu hình Aimlock cơ bản -->
      <option name="Com.Ss-Ffx64.Aps=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.AimLock.Enable=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.LockHead.Target=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Thuật toán dự đoán hướng di chuyển (Movement Tracking & Prediction) -->
      <option name="Com.Ss-Ffx64.TargetPrediction.Enable=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.MotionTracking.Speed=1.0" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.DynamicAimAssist=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Định danh tác giả -->
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>

  <!-- Version 3: Khởi chạy launcher & Cơ chế Anti-Ban/Bypass -->
  <project version="3">
    <Asset_DataAsset>
      <!-- Khai báo kích hoạt thuật toán -->
      <option name="acp_click=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="on_com.dts.freefireth_launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.restore-device.launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Anti-Ban, Bypass báo cáo và xóa nhật ký hành vi -->
      <option name="com.antiban.protection.status=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.bypass.report.system=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.clean.log.data=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Định danh tác giả -->
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>
</projects>