<?xml version="1.0" encoding="UTF-8"?>
<projects>
  <!-- Version 1: Khởi tạo hệ thống & Cấp quyền ghi đè bộ nhớ -->
  <project version="1">
    <component name="BallisticsAndSecurity" JavaVersion="1" />
    <component name="WriteSettingHideVersion" JavaVersion="1">
      <Asset_DataAsset>
        <option name="externalDataAsset" strings="$WRITE_EXTERNALS$" />
        <option name="com.android.accesspointernetwork" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.ACCESS_POINTER_SPEED" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <!-- Bypass chữ ký bảo mật Client -->
        <option name="com.android.security.ANTIBAN_BYPASS" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="COMPRESS" strings="true" />
      </Asset_DataAsset>
    </component>
  </project>s

  <!-- Version 2: Thuật toán vật lý đạn đạo (Êm, Đầm, Thấm) -->
  <project version="2">
    <Asset_DataAsset>
      <option name="on=1" strings="$WRITE_FILE$" />
      <option name="off=0" strings="$WRITE_FILE$" />
      <option name="Com.Ss-Ffx64.Aps=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Logic Êm Tâm & Nhẹ: Giảm xóc trục dọc (Vertical Damping) -->
      <option name="Com.Ss-Ffx64.Recoil.Vertical.Damping=0.15" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.Aim.SmoothTranslation=1.2" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Logic Đầm Tâm: Siết chặt độ lệch trục ngang -->
      <option name="Com.Ss-Ffx64.Recoil.Horizontal.Stabilizer=0.03" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.Crosshair.DynamicWeight=85" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Logic Thấm (Tối ưu Hit-registration): Đồng bộ gói tin trúng đích -->
      <option name="Com.Ss-Ffx64.Bullet.HitboxSync.Priority=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.Network.HitRegistration=Aggressive" strings="$WRITE_REGULATOR_DATA$" />

      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>

  <!-- Version 3: Launcher, Xóa Log & Antiban Server-side -->
  <project version="3">
    <Asset_DataAsset>
      <option name="acp_click=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="on_com.dts.freefireth_launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.restore-device.launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Xóa dấu vết can thiệp (Log Wiper) & Chặn Heuristic -->
      <option name="com.bypass.server.report_log=0" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.security.anticheat.behavior_bypass=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>
</projects>