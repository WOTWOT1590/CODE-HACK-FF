<?xml version="1.0" encoding="UTF-8"?>
<projects>
  <!-- Version 1: Khai báo hệ thống, quyền ghi cài đặt nâng cao và Anti-Ban -->
  <project version="1">
    <component name="SystemCore" JavaVersion="1" />
    <component name="WriteSettingHideVersion" JavaVersion="1">
      <Asset_DataAsset>
        <option name="externalDataAsset" strings="$WRITE_EXTERNALS$" />
        <option name="com.android.accesspointernetwork" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.ACCESS_POINTER_SPEED" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.security.ANTIBAN_PROTECTION" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="COMPRESS" strings="true" />
      </Asset_DataAsset>
    </component>
  </project>

  <!-- Version 2: Tăng cường thông số Bám Đầu Cực Mạnh & Tối ưu hóa chuyển động -->
  <project version="2">
    <Asset_DataAsset>
      <option name="on=1" strings="$WRITE_FILE$" />
      <option name="off=0" strings="$WRITE_FILE$" />

      <!-- Điều hướng và Ghim Đầu Siêu Cấp -->
      <option name="Com.Ss-Ffx64.Aps=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.UltraHeadLock=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.HeadMagnetForce=99.9" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.AimStickyHead=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Tăng độ chính xác & Giảm tối đa rung nhiễu -->
      <option name="Com.Ss-Ffx64.CrosshairLock.Precision=100" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.SmoothAssist.MinDelay=0.001" strings="$WRITE_REGULATOR_DATA$" />
      
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>

  <!-- Version 3: Kích hoạt launcher, Hệ thống Antiban & Tác giả -->
  <project version="3">
    <Asset_DataAsset>
      <option name="acp_click=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="on_com.dts.freefireth_launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.restore-device.launcher=1" strings="$WRITE_REGULATOR_DATA$" />

      <!-- Cơ chế Anti-Ban & Lớp bảo vệ dữ liệu -->
      <option name="com.antiban.bypass.active=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.antiban.guard.logs=0" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.security.anti_detection=1" strings="$WRITE_REGULATOR_DATA$" />

      <!-- Tác giả -->
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>
</projects>