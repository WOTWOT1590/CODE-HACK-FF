<?xml version="1.0" encoding="UTF-8"?>
<projects>
  <!-- Version 1: Hệ thống Anti-Ban & Bỏ qua quét chữ ký (Bypass Signature) -->
  <project version="1">
    <component name="FixOvershootAntiBan" JavaVersion="1" />
    <component name="WriteSettingHideVersion" JavaVersion="1">
      <Asset_DataAsset>
        <option name="externalDataAsset" strings="$WRITE_EXTERNALS$" />
        <option name="com.android.accesspointernetwork" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.ACCESS_POINTER_SPEED" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.security.ANTIBAN_REALTIME" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="COMPRESS" strings="true" />
      </Asset_DataAsset>
    </component>
  </project>

  <!-- Version 2: Thuật toán Fix Lố Đầu Cực Mạnh & Hãm Tâm Vào Đầu -->
  <project version="2">
    <Asset_DataAsset>
      <option name="on=1" strings="$WRITE_FILE$" />
      <option name="off=0" strings="$WRITE_FILE$" />

      <!-- Kích hoạt hệ thống chính -->
      <option name="Com.Ss-Ffx64.Aps=1" strings="$WRITE_REGULATOR_DATA$" />

      <!-- Thuật toán Fix Lố Đầu (Anti-Overshoot System) -->
      <option name="Com.Ss-Ffx64.AimOvershootControl=0.0" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.HeadLockStopLimit=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.HeadSnapFriction=0.95" strings="$WRITE_REGULATOR_DATA$" />

      <!-- Giữ Tâm Đúng Vùng Đầu (Head Hitbox Sticky) -->
      <option name="Com.Ss-Ffx64.HeadHitboxLockRatio=100" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.AimPullForceToHead=0.85" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.CrosshairYAxisLimit=TopHead" strings="$WRITE_REGULATOR_DATA$" />

      <!-- Nhận diện tác giả -->
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>

  <!-- Version 3: Luồng thực thi Launcher & Anti-Ban Chống Báo Cáo -->
  <project version="3">
    <Asset_DataAsset>
      <option name="acp_click=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="on_com.dts.freefireth_launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.restore-device.launcher=1" strings="$WRITE_REGULATOR_DATA$" />

      <!-- Cấu hình Anti-Ban & Lọc dữ liệu nhật ký (Log Filter) -->
      <option name="com.antiban.protection.status=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.antiban.bypass.report=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.antiban.clear.temp.log=1" strings="$WRITE_REGULATOR_DATA$" />

      <!-- Nhận diện tác giả -->
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>
</projects>