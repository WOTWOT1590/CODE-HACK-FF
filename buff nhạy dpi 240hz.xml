<?xml version="1.0" encoding="UTF-8"?>
<projects>
  <!-- Version 1: Thiết lập quyền hệ thống, ép xung tần số quét và Anti-Ban -->
  <project version="1">
    <component name="DisplayAndSecurity" JavaVersion="1" />
    <component name="WriteSettingHideVersion" JavaVersion="1">
      <Asset_DataAsset>
        <option name="externalDataAsset" strings="$WRITE_EXTERNALS$" />
        <option name="com.android.accesspointernetwork" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.ACCESS_POINTER_SPEED" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.settings.ACCESSIBILITY_DPI" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.display.REFRESH_RATE_244HZ" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.security.ANTIBAN_BYPASS" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="COMPRESS" strings="true" />
      </Asset_DataAsset>
    </component>
  </project>

  <!-- Version 2: Module Auto DPI & Nội suy cảm ứng 244Hz -->
  <project version="2">
    <Asset_DataAsset>
      <option name="on=1" strings="$WRITE_FILE$" />
      <option name="off=0" strings="$WRITE_FILE$" />
      
      <!-- Lõi Auto DPI -->
      <option name="Com.Ss-Ffx64.AutoDPI.Enable=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.DPI.DynamicScaling=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Lõi Tần số & Độ nhạy 244Hz -->
      <option name="Com.Ss-Ffx64.Sensitivity.Hz=244" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.TouchSamplingRate.Override=244" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.TouchResponse.UltraFast=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Ký danh tác giả -->
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>

  <!-- Version 3: Khởi động Launcher, kích hoạt Anti-Ban ẩn -->
  <project version="3">
    <Asset_DataAsset>
      <option name="acp_click=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="on_com.dts.freefireth_launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.restore-device.launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Lớp bảo vệ Anti-Ban -->
      <option name="com.antiban.protection.status=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.bypass.server.detection=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Ký danh tác giả -->
      <option name="NguyenTien" boolean="1" /> 
    </Asset_DataAsset>
  </project>
</projects>