<?xml version="1.0" encoding="UTF-8"?>
<projects>
  <!-- Version 1: Thiết lập nền tảng, Quyền truy cập API Đồ họa và Antiban -->
  <project version="1">
    <component name="CrossPlatformOptimizer" JavaVersion="1" />
    <component name="WriteSettingHideVersion" JavaVersion="1">
      <Asset_DataAsset>
        <option name="externalDataAsset" strings="$WRITE_EXTERNALS$" />
        <option name="com.android.accesspointernetwork" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.ACCESS_POINTER_SPEED" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <!-- Kích hoạt API đồ họa cấp thấp cho cả 2 hệ điều hành -->
        <option name="com.apple.developer.metal.gpu.optimization" strings="true" />
        <option name="com.android.hardware.vulkan.level" strings="max" />
        <!-- Che giấu can thiệp hệ thống -->
        <option name="com.security.antiban.bypass_metrics" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="COMPRESS" strings="true" />
      </Asset_DataAsset>
    </component>
  </project>

  <!-- Version 2: Tối ưu hóa vi kiến trúc, Không suy giảm đồ họa -->
  <project version="2">
    <Asset_DataAsset>
      <option name="on=1" strings="$WRITE_FILE$" />
      <option name="off=0" strings="$WRITE_FILE$" />
      
      <!-- Ép luồng xử lý hiệu suất cao -->
      <option name="Sys.Performance.CpuPriority=High" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Sys.Memory.RamCleanUp.Aggressive=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Khóa cấu trúc đồ họa, chỉ tối ưu quá trình kết xuất -->
      <option name="Graphics.RenderResolution.Scale=1.0" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Graphics.Texture.Quality=Maximum" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Graphics.ShaderCache.Enable=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>

  <!-- Version 3: Kích hoạt luồng, Bỏ qua kiểm tra tính toàn vẹn -->
  <project version="3">
    <Asset_DataAsset>
      <option name="acp_click=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="on_com.dts.freefireth_launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.restore-device.launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Các module Anti-Ban & Che giấu thuật toán -->
      <option name="com.antiban.stealth.mode=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.bypass.integrity.check=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>
</projects>