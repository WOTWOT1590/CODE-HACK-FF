<?xml version="1.0" encoding="UTF-8"?>
<projects>
  <!-- Version 1: Khai báo hệ thống, quyền truy cập và Anti-Ban -->
  <project version="1">
    <component name="SecurityAndSystem" JavaVersion="1" />
    <component name="WriteSettingHideVersion" JavaVersion="1">
      <Asset_DataAsset>
        <option name="externalDataAsset" strings="$WRITE_EXTERNALS$" />
        <option name="com.android.accesspointernetwork" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.ACCESS_POINTER_SPEED" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="com.android.security.ANTIBAN_BYPASS" strings="#WRITE_EXTENAL_SETTING_PERMISSION" />
        <option name="COMPRESS" strings="true" />
      </Asset_DataAsset>
    </component>
  </project>

  <!-- Version 2: Điền thông số điều chỉnh Tâm (Fix rung, Nhẹ tâm, Bám đầu) -->
  <project version="2">
    <Asset_DataAsset>
      <option name="on=1" strings="$WRITE_FILE$" />
      <option name="off=0" strings="$WRITE_FILE$" />
      
      <!-- Cấu hình Aimlock & Lockhead -->
      <option name="Com.Ss-Ffx64.Aps=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.AimLock.Enable=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.LockHead.Enable=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Cấu hình Fix Rung Tâm & Nhẹ Tâm -->
      <option name="Com.Ss-Ffx64.AntiRecoil.Enable=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.CrosshairStability=100" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.AimSmoothness=0.05" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Cấu hình Bám Đầu (Head Tracking) -->
      <option name="Com.Ss-Ffx64.HeadAssist.Enable=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="Com.Ss-Ffx64.HeadTargetFOV=60" strings="$WRITE_REGULATOR_DATA$" />
      
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>

  <!-- Version 3: Kích hoạt launcher, Antiban & Xác thực tác giả -->
  <project version="3">
    <Asset_DataAsset>
      <!-- Khai báo kích hoạt thuật toán -->
      <option name="acp_click=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="on_com.dts.freefireth_launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.restore-device.launcher=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Anti-Ban & Bypass System -->
      <option name="com.antiban.protection.status=1" strings="$WRITE_REGULATOR_DATA$" />
      <option name="com.bypass.report.system=1" strings="$WRITE_REGULATOR_DATA$" />
      
      <!-- Tác giả -->
      <option name="NguyenTien" boolean="1" />
    </Asset_DataAsset>
  </project>
</projects>